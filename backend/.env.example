OPENAI_API_KEY=
OPENAI_MODEL=
# Supabase → Project Settings → Database → Connect → Session pooler (IPv4). Replace [YOUR-PASSWORD].
# Do NOT use the "Direct connection" host db.<ref>.supabase.co: it is IPv6-only and fails with "Network is unreachable".
# For offline local dev you can use: sqlite:///./aqylroute.db
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Comma-separated. In production add the Vercel domain, e.g. http://localhost:3000,https://aqylroute.vercel.app
CORS_ORIGINS=http://localhost:3000
# Optional: also allow Vercel preview deployments, e.g. https://haqaton-037-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Auth
# Production: a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_TTL_HOURS=72

# smsc.kz — leave SMSC_LOGIN empty to print OTP codes to the server log instead of sending SMS
SMSC_LOGIN=
SMSC_PASSWORD=
# Must be a sender name registered in smsc.kz → Отправители; KZ operators reject the default SMS-CENTRE.
SMSC_SENDER=

# Supabase API keys (not used by the DB connection; secret key is backend-only, never expose it)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
